{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.4"}
        org.clojure/data.json {:mvn/version "2.5.2"}
        exoscale/ex {:mvn/version "0.4.2"}
        exoscale/cloak {:mvn/version "1.0.42"}}
 :aliases {:carve {:extra-deps {borkdude/carve
                                {:git/url "https://github.com/borkdude/carve"
                                 :sha "4b5010a09e030dbd998faff718d12400748ab3b9"}}
                   :main-opts ["-m" "carve.main"]}
           :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.6"}}
                   :ns-default build}
           :test {:extra-deps {org.clojure/test.check {:mvn/version "1.1.3"}
                               lambdaisland/kaocha {:exoscale.deps/inherit :all,
                                                    :mvn/version "1.91.1392"}}
                  :extra-paths ["test" "test/resources"]
                  :exec-fn kaocha.runner/exec-fn}
           :install {:extra-deps {io.github.slipset/deps-deploy {:git/sha "4e8709b54e24f12c385b6778d5b4236cee66cbe5"}}
                     :exec-fn deps-deploy.deps-deploy/deploy
                     :exec-args {:installer :local
                                 ;; TODO ... AUTOMATE
                                 :artifact "target/itsdangerous-0.2.0.jar"}}
           :deploy {:extra-deps {io.github.slipset/deps-deploy {:git/sha "4e8709b54e24f12c385b6778d5b4236cee66cbe5"}}
                    :exec-fn deps-deploy.deps-deploy/deploy
                    :exec-args {:installer :remote
                                ;; TODO ... AUTOMATE
                                :artifact "target/itsdangerous-0.2.0.jar"}}}}
